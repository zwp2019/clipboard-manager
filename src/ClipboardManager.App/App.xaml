<Application x:Class="ClipboardManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="Styles/Glass.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Theme-dependent brushes live ONLY in theme dictionaries. A root-level
                 brush with the same key overrides theme lookup in control templates. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="CardTextFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#F1F0EE"/>
                    <SolidColorBrush x:Key="PanelTintBrush" Color="#66F6F4F0"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#0D222126"/>
                    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#18222126"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#12000000"/>
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#90FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#27272C"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#737379"/>
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#74747C"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#7166D8"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#14222126"/>
                    <SolidColorBrush x:Key="SearchBrush" Color="#CCFFFFFF"/>
                    <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#F1F2F4"/>
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#06000000"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#CCFFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#27272C"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#27272C"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#27272C"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#74747C"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#74747C"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7166D8"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <LinearGradientBrush x:Key="CardTextFadeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00292A2F" Offset="0"/><GradientStop Color="#292A2F" Offset="1"/>
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="BackgroundBrush" Color="#292A2F"/>
                    <SolidColorBrush x:Key="PanelTintBrush" Color="#66292A2F"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#292A2F"/>
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#22FFFFFF"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F6"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8C0"/>
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#B0B0B8"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#B2A8FF"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="SearchBrush" Color="#D5393A40"/>
                    <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="#32333B"/>
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#08FFFFFF"/>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#393A40"/>
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#393A40"/>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#414249"/>
                    <SolidColorBrush x:Key="TextControlForeground" Color="#F4F4F6"/>
                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4F4F6"/>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F4F4F6"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B0B0B8"/>
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#B0B0B8"/>
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#B2A8FF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardTextFadeBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PanelTintBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="SearchBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="PreviewPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="Transparent"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="TypeTextBrush" Color="#FFBE00"/>
            <SolidColorBrush x:Key="TypeUrlBrush" Color="#078BFA"/>
            <SolidColorBrush x:Key="TypeImageBrush" Color="#FF4D68"/>
            <SolidColorBrush x:Key="TypeCodeBrush" Color="#9170D4"/>
            <SolidColorBrush x:Key="TypeFileBrush" Color="#2BB77B"/>
            <SolidColorBrush x:Key="TypeColorBrush" Color="#7C8B99"/>
            <SolidColorBrush x:Key="CardHeaderTextBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardWarmHeaderTextBrush" Color="#4C3E17"/>
            <SolidColorBrush x:Key="CardIconPlateBrush" Color="#F2FFFFFF"/>
            <SolidColorBrush x:Key="CardImageBadgeBrush" Color="#8A202024"/>
            <SolidColorBrush x:Key="PinboardFavoriteBrush" Color="#FFBE00"/>
            <FontFamily x:Key="FontFamilyUi">Segoe UI Variable, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="FontFamilyMono">Cascadia Code, Consolas</FontFamily>
            <x:Double x:Key="CardWidth">208</x:Double>
            <x:Double x:Key="CardHeight">208</x:Double>
            <CornerRadius x:Key="CornerRadiusWindow">20</CornerRadius>
            <CornerRadius x:Key="CornerRadiusCard">14</CornerRadius>

            <Style x:Key="DockIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassCapsuleButtonStyle}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="PinboardTabStyle" TargetType="Button" BasedOn="{StaticResource GlassCapsuleButtonStyle}">
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="DockCardItemStyle" TargetType="ListViewItem">
                <Setter Property="UseSystemFocusVisuals" Value="False"/>
                <Setter Property="FocusVisualPrimaryThickness" Value="0"/>
                <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,3,18,3"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Width="208" Height="208" VerticalAlignment="Top">
                                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                <Border x:Name="HoverBorder" BorderBrush="{ThemeResource GlassRimBrush}" BorderThickness="1" CornerRadius="14" Opacity="0" IsHitTestVisible="False"/>
                                <Border x:Name="SelectedBorder" BorderBrush="{ThemeResource GlassSelectionBrush}" BorderThickness="1.5" CornerRadius="14" Opacity="0" IsHitTestVisible="False"/>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HoverBorder.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="SelectedBorder.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="SelectedBorder.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HoverBorder.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="FocusStates">
                                        <VisualState x:Name="Unfocused"/>
                                        <VisualState x:Name="PointerFocused"/>
                                        <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="SelectedBorder.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
