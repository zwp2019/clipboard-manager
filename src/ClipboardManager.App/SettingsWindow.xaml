<Window
    x:Class="ClipboardManager.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Clipboard Manager Settings">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Settings"
            Style="{StaticResource TitleTextBlockStyle}"
            Margin="24,20,24,8" />

        <ScrollViewer Grid.Row="1" Margin="24,4,24,0">
            <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

                <!-- 全局热键（规范 §28） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Global Hotkey" FontWeight="SemiBold" />
                    <TextBox
                        x:Name="HotkeyBox"
                        Text="{x:Bind ViewModel.Hotkey, Mode=TwoWay}"
                        KeyDown="HotkeyBox_KeyDown"
                        PlaceholderText="Ctrl+Shift+V" />
                    <TextBlock
                        Text="{x:Bind ViewModel.HotkeyStatus, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 主题（规范 §47） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <ComboBox
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                        HorizontalAlignment="Left" MinWidth="200">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>

                <!-- 历史保留（规范 §40） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="History Retention" FontWeight="SemiBold" />
                    <ComboBox
                        SelectedValue="{x:Bind ViewModel.RetentionDays, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        HorizontalAlignment="Left" MinWidth="200">
                        <ComboBoxItem Content="1 day" Tag="1" />
                        <ComboBoxItem Content="7 days" Tag="7" />
                        <ComboBoxItem Content="30 days" Tag="30" />
                        <ComboBoxItem Content="90 days" Tag="90" />
                        <ComboBoxItem Content="Forever" Tag="0" />
                    </ComboBox>
                </StackPanel>

                <!-- 去重（规范 §15） -->
                <ToggleSwitch
                    Header="Duplicate Handling"
                    OnContent="Deduplicate"
                    OffContent="Keep duplicates"
                    IsOn="{x:Bind ViewModel.EnableDeduplication, Mode=TwoWay}" />

                <!-- 最大历史（规范 §46） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Maximum History Items" FontWeight="SemiBold" />
                    <NumberBox
                        Value="{x:Bind ViewModel.MaxHistoryItems, Mode=TwoWay}"
                        Minimum="100"
                        Maximum="1000000"
                        SmallChange="1000"
                        SpinButtonPlacementMode="Compact" />
                </StackPanel>

                <!-- 图片压缩（规范 §46） -->
                <ToggleSwitch
                    Header="Image Compression"
                    OnContent="Enabled"
                    OffContent="Disabled"
                    IsOn="{x:Bind ViewModel.ImageCompression, Mode=TwoWay}" />

                <!-- 暂停监控 -->
                <ToggleSwitch
                    Header="Pause Monitoring"
                    OnContent="Paused"
                    OffContent="Monitoring"
                    IsOn="{x:Bind ViewModel.PauseMonitoring, Mode=TwoWay}" />

                <!-- 开机自启（规范 §32） -->
                <ToggleSwitch
                    Header="Start With Windows"
                    OnContent="Enabled"
                    OffContent="Disabled"
                    IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" />

                <!-- 排除应用：隐私保护（规范 §39） -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Excluded Applications" FontWeight="SemiBold" />
                    <TextBlock
                        Text="来自这些应用的复制内容不会被记录（如密码管理器、银行软件）。"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="ExcludeAppBox"
                            PlaceholderText="应用名（如 1Password）"
                            Width="260" />
                        <Button Content="Add" Click="AddExcludedApp_Click" />
                        <Button Content="Add Current App" Click="AddCurrentApp_Click" />
                    </StackPanel>
                    <ListView
                        ItemsSource="{x:Bind ViewModel.ExcludedApplications, Mode=OneWay}"
                        MaxHeight="160"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="1"
                                        Content="Remove"
                                        Click="RemoveExcludedApp_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- 数据管理（规范 §46） -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Data Management" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Backup Database" Click="BackupButton_Click" />
                        <Button Content="Restore Database" Click="RestoreButton_Click" />
                        <Button Content="Clear History" Click="ClearHistoryButton_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="24,12,24,20">
            <Button Content="Cancel" Click="CancelButton_Click" />
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
