<Window x:Class="ClipboardManager.App.Controls.GlassDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClipboardManager.App.Controls" Title="剪贴板">
    <Grid x:Name="DialogRoot" Background="{ThemeResource BackgroundBrush}" KeyDown="Root_KeyDown">
        <Border Background="{ThemeResource GlassWindowTintBrush}" BorderBrush="{ThemeResource GlassRimBrush}" BorderThickness="1" CornerRadius="22"/>
        <Grid Padding="24" RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Click="Close_Click" Style="{StaticResource DockIconButtonStyle}" AutomationProperties.Name="关闭弹窗" ToolTipService.ToolTip="关闭 (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter x:Name="ContentHost" Foreground="{ThemeResource TextPrimaryBrush}" HorizontalContentAlignment="Stretch"/>
            </ScrollViewer>
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="SecondaryAction" HorizontalAlignment="Left" Style="{StaticResource GlassButtonStyle}" Click="Secondary_Click"/>
                <Button x:Name="CloseAction" Grid.Column="1" Style="{StaticResource GlassButtonStyle}" Click="Close_Click"/>
                <Button x:Name="PrimaryAction" Grid.Column="2" Style="{StaticResource GlassPrimaryButtonStyle}" Click="Primary_Click" MinWidth="100"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
