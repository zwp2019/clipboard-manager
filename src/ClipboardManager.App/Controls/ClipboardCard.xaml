<UserControl x:Class="ClipboardManager.App.Controls.ClipboardCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="{StaticResource CardWidth}" Height="{StaticResource CardHeight}">
    <Grid x:Name="ShadowHost" IsHitTestVisible="False"/>
    <Rectangle x:Name="ShadowMask" RadiusX="14" RadiusY="14" Fill="{ThemeResource SurfaceBrush}" IsHitTestVisible="False"/>
    <Border Width="{StaticResource CardWidth}" Height="{StaticResource CardHeight}"
        Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource CornerRadiusCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="14,14,0,0" Background="{x:Bind Item.HeaderBrush, Mode=OneWay}">
                <Grid>
                    <StackPanel Margin="11,6,48,5" Spacing="0" ToolTipService.ToolTip="{x:Bind Item.SourceDescription, Mode=OneWay}">
                        <TextBlock Text="{x:Bind Item.TypeLabel, Mode=OneWay}" FontSize="12.5" FontWeight="Medium" Foreground="{x:Bind Item.HeaderTextBrush, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind Item.TimeText, Mode=OneWay}" FontSize="10" Foreground="{x:Bind Item.HeaderTextBrush, Mode=OneWay}" Opacity="0.86"/>
                    </StackPanel>
                    <Border Width="44" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="0,14,0,0" ToolTipService.ToolTip="{x:Bind Item.SourceName, Mode=OneWay}">
                        <Grid>
                            <Image Source="{x:Bind Item.SourceAppIconSource, Mode=OneWay}" Width="40" Height="40" Stretch="Uniform" Visibility="{x:Bind Item.SourceIconVisibility, Mode=OneWay}"/>
                            <FontIcon Glyph="{x:Bind Item.TypeGlyph, Mode=OneWay}" FontSize="27" Foreground="{x:Bind Item.HeaderTextBrush, Mode=OneWay}" Visibility="{x:Bind Item.SourceFallbackVisibility, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="11,9,11,0" Spacing="5" Visibility="{x:Bind Item.CardPreviewVisibility, Mode=OneWay}">
                <TextBlock Text="{x:Bind Item.ContentTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextPrimaryBrush}" Visibility="{x:Bind Item.ContentTitleVisibility, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind Item.CardPreviewText, Mode=OneWay}" FontFamily="{x:Bind Item.PreviewFont, Mode=OneWay}" FontSize="12.5" LineHeight="17"
                    Foreground="{ThemeResource TextPrimaryBrush}" TextWrapping="Wrap" MaxLines="{x:Bind Item.PreviewMaxLines, Mode=OneWay}" TextTrimming="None"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{x:Bind Item.ThumbnailVisibility, Mode=OneWay}" Background="{ThemeResource PreviewPlaceholderBrush}" CornerRadius="0,0,14,14">
                <Image Source="{x:Bind Item.ThumbnailSource, Mode=OneWay}" Stretch="Uniform"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="16"
                    Visibility="{x:Bind Item.ImagePlaceholderVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xEB9F;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind Item.ImageCaption, Mode=OneWay}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="6,2" CornerRadius="6" Background="{StaticResource CardImageBadgeBrush}">
                    <TextBlock Text="{x:Bind Item.ImageCaption, Mode=OneWay}" Foreground="{StaticResource CardHeaderTextBrush}" FontSize="10" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Grid.RowSpan="2" Background="{x:Bind Item.ColorBrush, Mode=OneWay}" Visibility="{x:Bind Item.ColorVisibility, Mode=OneWay}" CornerRadius="0,0,14,14">
                <TextBlock Text="{x:Bind Item.CardPreviewText, Mode=OneWay}" FontFamily="{StaticResource FontFamilyMono}" FontSize="23" FontWeight="SemiBold"
                    Foreground="{x:Bind Item.ColorTextBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1" Height="22" VerticalAlignment="Bottom" Background="{ThemeResource CardTextFadeBrush}" Visibility="{x:Bind Item.CardPreviewVisibility, Mode=OneWay}" IsHitTestVisible="False"/>
            <Grid Grid.Row="2" Margin="12,0,12,5" Visibility="{x:Bind Item.CardPreviewVisibility, Mode=OneWay}">
                <TextBlock Text="{x:Bind Item.CardFooterText, Mode=OneWay}" HorizontalAlignment="{x:Bind Item.FooterAlignment, Mode=OneWay}" MaxWidth="180"
                    FontSize="10" Foreground="{ThemeResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <FontIcon Glyph="&#xE735;" FontSize="9" HorizontalAlignment="Right" Foreground="{ThemeResource TextTertiaryBrush}" Visibility="{x:Bind Item.FavoriteVisibility, Mode=OneWay}"/>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
