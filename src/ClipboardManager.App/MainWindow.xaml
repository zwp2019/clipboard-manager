<Window x:Class="ClipboardManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClipboardManager.App.ViewModels"
    xmlns:controls="using:ClipboardManager.App.Controls" Title="剪贴板管理器">
    <Grid x:Name="RootGrid" Background="{ThemeResource BackgroundBrush}">
        <Border CornerRadius="{StaticResource CornerRadiusWindow}" Background="Transparent"
            BorderBrush="{ThemeResource GlassRimBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="222"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>

                <!-- One quiet navigation row. The search field expands only on demand. -->
                <Grid Padding="16,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="NavigationCluster" Grid.Column="1" MaxWidth="900" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid x:Name="SearchHost" Width="32" VerticalAlignment="Center">
                        <Button x:Name="SearchToggle" Click="SearchToggle_Click" Style="{StaticResource DockIconButtonStyle}" ToolTipService.ToolTip="搜索 (Ctrl+F)">
                            <FontIcon Glyph="&#xE721;" FontSize="15"/>
                        </Button>
                        <TextBox x:Name="SearchBox" Visibility="Collapsed" MinWidth="0" Height="32" Padding="10,5" CornerRadius="8"
                            PlaceholderText="搜索剪贴板…" AutomationProperties.Name="搜索剪贴板"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="SearchBox_KeyDown" Foreground="{ThemeResource TextPrimaryBrush}" Background="{ThemeResource SearchBrush}" FontSize="12"/>
                    </Grid>

                    <ScrollViewer x:Name="CategoryScroll" Grid.Column="1" HorizontalContentAlignment="Center"
                        HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="CategoryScroll_PointerWheelChanged">
                        <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="TabClipboard" Click="Tab_Click" Style="{StaticResource PinboardTabStyle}" AutomationProperties.Name="剪贴板历史">
                                <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE81C;" FontSize="12"/><TextBlock Text="剪贴板" FontSize="12"/></StackPanel>
                            </Button>
                            <Button x:Name="TabFavorites" Click="Tab_Click" Style="{StaticResource PinboardTabStyle}" AutomationProperties.Name="收藏">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PinboardFavoriteBrush}"/>
                                    <TextBlock Text="收藏" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabAddGroup" Click="AddGroupButton_Click" Style="{StaticResource DockIconButtonStyle}" ToolTipService.ToolTip="新建收藏板">
                                <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                    <Button x:Name="OverflowButton" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource DockIconButtonStyle}" ToolTipService.ToolTip="更多操作">
                        <FontIcon Glyph="&#xE712;" FontSize="17"/>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Name="FilterButton" Text="筛选当前列表…" Click="Filter_Click"/>
                                <MenuFlyoutSubItem Text="内容类型">
                                    <MenuFlyoutItem Text="全部内容" Tag="All" Click="TypeMenu_Click"/>
                                    <MenuFlyoutItem Text="文本" Tag="Text" Click="TypeMenu_Click"/>
                                    <MenuFlyoutItem Text="链接" Tag="Url" Click="TypeMenu_Click"/>
                                    <MenuFlyoutItem Text="图片" Tag="Image" Click="TypeMenu_Click"/>
                                    <MenuFlyoutItem Text="代码" Tag="Code" Click="TypeMenu_Click"/>
                                    <MenuFlyoutItem Text="文件" Tag="File" Click="TypeMenu_Click"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="新建常用文本…" Click="NewItem_Click"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutSubItem Text="{x:Bind ViewModel.QueueLabel, Mode=OneWay}">
                                    <MenuFlyoutItem Text="打开队列" Click="QueueOpen_Click"/>
                                    <MenuFlyoutItem Text="将所选内容加入队列" Click="QueueAdd_Click"/>
                                    <MenuFlyoutItem Text="反转顺序" Click="QueueReverse_Click"/>
                                    <MenuFlyoutItem Text="清空队列" Click="QueueClear_Click"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="批量操作">
                                    <MenuFlyoutItem Text="选择已加载的全部内容" Click="SelectAll_Click"/>
                                    <MenuFlyoutItem Text="收藏所选" Click="BatchFavorite_Click"/>
                                    <MenuFlyoutItem Text="移入收藏板…" Click="BatchGroup_Click"/>
                                    <MenuFlyoutItem Text="删除所选…" Click="BatchDelete_Click"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSubItem Text="暂停记录">
                                    <MenuFlyoutItem Text="暂停 5 分钟" Tag="5" Click="Pause_Click"/>
                                    <MenuFlyoutItem Text="暂停 30 分钟" Tag="30" Click="Pause_Click"/>
                                    <MenuFlyoutItem Text="恢复记录" Tag="0" Click="Pause_Click"/>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="快捷键" Click="ShortcutHelp_Click"/>
                                <MenuFlyoutItem Text="偏好设置…" Click="SettingsButton_Click"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ListView x:Name="HistoryList" Padding="20,0,0,8"
                        ItemsSource="{x:Bind ViewModel.Items}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                        SelectionMode="Extended" IsItemClickEnabled="False" DoubleTapped="HistoryList_DoubleTapped"
                        SelectionChanged="HistoryList_SelectionChanged"
                        CanDragItems="True" DragItemsStarting="HistoryList_DragItemsStarting"
                        ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        PointerWheelChanged="HistoryList_PointerWheelChanged"
                        ItemContainerStyle="{StaticResource DockCardItemStyle}" Loaded="HistoryList_Loaded">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                                <controls:ClipboardCard Item="{x:Bind}" RightTapped="Card_RightTapped"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveList, Mode=OneWay}" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="复制一些内容，或换个关键词试试" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- No persistent toolbar: only a quiet state line and a pagination fallback. -->
                <Grid Grid.Row="2" Margin="20,0,20,3" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <ProgressRing Grid.Column="1" Width="12" Height="12" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"/>
                    <HyperlinkButton Grid.Column="2" Content="更多历史 →" FontSize="9" Padding="0" MinHeight="0" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextSecondaryBrush}" Visibility="{x:Bind ViewModel.MoreVisibility, Mode=OneWay}" Click="LoadMore_Click"/>
                </Grid>
            </Grid>
        </Border>
        <InfoBar x:Name="CopyNotice" IsOpen="False" IsClosable="True" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,26" MaxWidth="520"/>
        <Border x:Name="ModalShade" Background="{ThemeResource GlassDimBrush}" CornerRadius="20" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</Window>
