<Window
    x:Class="ClipboardManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ClipboardManager.App.ViewModels"
    mc:Ignorable="d"
    Title="Clipboard Manager">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索框（规范 §24、§27） -->
        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="0"
            Margin="12,14,12,6"
            PlaceholderText="🔍 Search clipboard..."
            QueryIcon="Find"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
            QuerySubmitted="SearchBox_QuerySubmitted"
            KeyDown="SearchBox_KeyDown" />

        <!-- 历史列表：ListView 自带 UI 虚拟化（规范 §26） -->
        <ListView
            x:Name="HistoryList"
            Grid.Row="1"
            Margin="8,0,8,4"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            DoubleTapped="HistoryList_DoubleTapped"
            KeyDown="HistoryList_KeyDown"
            Padding="0,0,0,4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="56" />
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardItemViewModel">
                    <Grid ColumnSpacing="12" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 缩略图 / 类型图标 -->
                        <Grid
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            VerticalAlignment="Center">
                            <Image
                                Source="{x:Bind ThumbnailSource}"
                                Stretch="Uniform"
                                Visibility="{x:Bind ThumbnailVisibility}"
                                Loaded="Thumbnail_Loaded" />
                            <Border
                                Width="36"
                                Height="36"
                                CornerRadius="8"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                Visibility="{x:Bind TypeIconVisibility}">
                                <FontIcon
                                    Glyph="{x:Bind TypeGlyph}"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- 内容预览 -->
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Text="{x:Bind DisplayText}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1"
                                FontSize="14"
                                IsTextSelectionEnabled="True" />
                            <TextBlock
                                Text="{x:Bind DetailText}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1"
                                Visibility="{x:Bind DetailTextVisibility}" />
                        </StackPanel>

                        <!-- 时间 + 操作 -->
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Spacing="4">
                            <TextBlock
                                Text="{x:Bind TimeText}"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                <Button
                                    Padding="6,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="收藏"
                                    Click="FavoriteButton_Click"
                                    Tag="{x:Bind IsFavorite}">
                                    <FontIcon Glyph="{x:Bind FavoriteGlyph}" FontSize="14" />
                                </Button>
                                <Button
                                    Padding="6,2"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="删除"
                                    Click="DeleteButton_Click">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部工具栏（规范 §24） -->
        <Grid Grid.Row="2" Padding="12,6,12,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1" Content="Favorites" Click="FavoritesButton_Click" />
            <Button Grid.Column="2" Content="History" Click="HistoryButton_Click" Margin="8,0,0,0" />
            <Button Grid.Column="3" Content="Settings" Click="SettingsButton_Click" Margin="8,0,0,0" />
        </Grid>
    </Grid>
</Window>
